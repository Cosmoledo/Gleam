{
	"name": "@cosmoledo/gleam",
	"version": "1.0.6",
	"description": "TypeScript framework for 2D canvas games in the browser — graphics, loop, effects, audio, math.",
	"homepage": "https://github.com/Cosmoledo/Gleam#readme",
	"bugs": {
		"url": "https://github.com/Cosmoledo/Gleam/issues"
	},
	"type": "module",
	"main": "dist/esm/index.js",
	"types": "dist/gleam.d.ts",
	"exports": {
		".": {
			"types": "./dist/gleam.d.ts",
			"import": "./dist/esm/index.js"
		}
	},
	"sideEffects": [
		"./src/prototypes/*",
		"./src/localization/Translator.ts",
		"./dist/esm/prototypes/*.js",
		"./dist/esm/localization/Translator.js"
	],
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"changelog": "node node_modules/keep-a-changelog/bin.js --url https://github.com/Cosmoledo/Gleam",
		"docs": "node scripts/docs.mjs",
		"lint": "eslint src tests --ext .ts",
		"prepublishOnly": "bash scripts/verify.sh",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"version": "node node_modules/keep-a-changelog/bin.js --release && npm run changelog && git add CHANGELOG.md"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"game",
		"canvas",
		"typescript",
		"framework",
		"2d",
		"renderer"
	],
	"author": "Cosmoledo",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.64.0",
		"@typescript-eslint/parser": "^8.64.0",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.28.1",
		"happy-dom": "^20.11.0",
		"keep-a-changelog": "^3.0.5",
		"playwright": "^1.61.1",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"vitest-canvas-mock": "^1.1.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cosmoledo/Gleam.git"
	},
	"allowScripts": {
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.1": true
	}
}
